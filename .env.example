# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Public URL of the deployed site (used for SEO / sitemap)
NEXT_PUBLIC_SITE_URL=https://www.ifotoz.com

# Maximum upload sizes in megabytes (Supabase Free plan caps single files at 50 MB)
NEXT_PUBLIC_MAX_PHOTO_MB=25
NEXT_PUBLIC_MAX_VIDEO_MB=50

# Admins log in with their mobile number. Each admin user in Supabase is created with the email
# <name>+<10-digit mobile>@<domain> built from this inbox, e.g. cnu.kunchala+9849305063@gmail.com
NEXT_PUBLIC_ADMIN_LOGIN_EMAIL_BASE=cnu.kunchala@gmail.com
